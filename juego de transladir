import random
import time
from deep_translator import GoogleTranslator
import scipy.io.wavfile as wav
import sounddevice as sd
import speech_recognition as sr
import sys

sys.stdout.reconfigure(encoding="utf-8")

words_by_level = {
    "facil": ["gato", "perro", "manzana", "leche", "sol"],
    "medio": ["banano", "escuela", "amigo", "ventana", "amarillo"],
    "dificil": ["tecnologia", "universidad", "informacion", "pronunciacion", "imaginacion"],
}

duration = 5  # segundos de grabación
sample_rate = 44100

inp1 = input("Elige un nivel de dificultad (facil, medio, dificil): ").lower()

if inp1 not in words_by_level:
    print("Nivel de dificultad no válido. Por favor, elige entre facil, medio o dificil😑.")
    exit()

# 1. Save the randomly chosen Spanish word to a variable
target_word_es = random.choice(words_by_level[inp1])

from deep_translator import MyMemoryTranslator

# Initialize MyMemory (source Spanish, target English)
translator = MyMemoryTranslator(source="es-ES", target="en-US")

# Usage remains identical
target_word_en = translator.translate(target_word_es)

print(f"\nTu palabra es: {target_word_es.upper()} (En inglés: {target_word_en})")

time.sleep(2)
print("\nHabla ahora...")

recording = sd.rec(int(duration * sample_rate), samplerate=sample_rate, channels=1, dtype="int16")
sd.wait()
wav.write("output.wav", sample_rate, recording)

print("Grabación completa, reconociendo...")

recognizer = sr.Recognizer()
with sr.AudioFile("output.wav") as source:
    audio = recognizer.record(source)

try:
    # Speech recognition in Spanish
    spoken_text = recognizer.recognize_google(audio, language="es-ES").strip().lower()
    print(f"Dijiste: '{spoken_text}'")

    # Translate what the user said to English
    spoken_translation = translator.translate(spoken_text)
    print(f"🌍 Traducción al inglés: {spoken_translation}")

    # Compare what they said against the selected target word
    if spoken_text == target_word_es.lower():
        print("¡Correcto! Has dicho la palabra correcta.✅")
    else:
        print(f"Incorrecto. Esperaba '{target_word_es}'🇪🇸, pero dijiste '{spoken_text}'.")

except sr.UnknownValueError:
    print("No se pudo reconocer el habla.")
except sr.RequestError as e:
    print(f"Error del servicio de reconocimiento de voz: {e}")
